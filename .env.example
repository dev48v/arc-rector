# Copy to `.env` (which is gitignored) and fill in only what you need.
# Arc Rector runs with NONE of these set. Every default path is key-free.

# ---------------------------------------------------------------------------
# L0 -- NVIDIA NIM free tier. The ONLY key this project can use, and it is
# optional: it exists for machines that cannot run a local model. Get one from
# https://build.nvidia.com. No adapter ever prints, logs, or echoes this value.
# ---------------------------------------------------------------------------
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# L1 -- Langfuse. These match the LANGFUSE_INIT_* values seeded by
# docker-compose.yml, so tracing works on first boot with nothing to configure.
# They are local development credentials for a container on your own machine.
# Regenerate them before anything is reachable by anyone else.
# ---------------------------------------------------------------------------
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-arc-rector-local
# LANGFUSE_SECRET_KEY=sk-lf-arc-rector-local

# ---------------------------------------------------------------------------
# Level overrides. Anything in config.yaml can be set here instead.
#   ARC_<LEVEL>=<adapter>              swap a whole level
#   ARC_<LEVEL>__<SETTING>=<value>     override one setting
# ---------------------------------------------------------------------------
# ARC_L0_INFERENCE=ollama
# ARC_L0_INFERENCE__MODEL=llama3.2:3b
# ARC_L0_INFERENCE__NUM_THREAD=8          # match your core count on a CPU box
# ARC_L1_OBSERVABILITY=none               # low-RAM opt-out: skip the Langfuse stack
# ARC_L3_FRAMEWORK=langgraph
# ARC_L4_VECTORSTORE=qdrant
# ARC_L5_EMBEDDINGS=nomic
# ARC_L7_MEMORY=mem0
# ARC_L8_GUARDRAILS=guardrails-ai
# ARC_PIPELINE__TOP_K=4

# ---------------------------------------------------------------------------
# Optional self-hosted services used by non-default adapters.
# ---------------------------------------------------------------------------
# FIRECRAWL_API_KEY=                      # only for Firecrawl CLOUD; self-host needs none
# NEO4J_URI=bolt://localhost:7687         # graphiti
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Deployment (see DEPLOY.md). Regenerate ALL of these for any shared host.
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
# REDIS_PASSWORD=
# MINIO_PASSWORD=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_USER_PASSWORD=
# PUBLIC_URL=https://arc.example.com
